APP_NAME="Table Tally POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Neon — pooled URL for the app; direct (non-pooler) URL for container migrations
DB_CONNECTION=pgsql
DB_URL="your_neon_pooling_url_here"
DIRECT_URL="postgresql://your_direct_url_here"
DATABASE_POOL_MAX=10

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Birch CP-Q1UN kitchen printer on the LAN. Raw ESC/POS port is 9100.
# Leave the host empty until the printer address is known.
KITCHEN_PRINTER_HOST=
KITCHEN_PRINTER_PORT=9100
KITCHEN_PRINTER_TIMEOUT=4

# Receipt printer with cash drawer (ESC/POS drawer kick on port 9100). Card payments never open the drawer.
CASH_DRAWER_PRINTER_HOST=
CASH_DRAWER_PRINTER_PORT=9100
CASH_DRAWER_PRINTER_TIMEOUT=4